# Required Environment Variables (No Group IDs needed in .env!)
# All group configurations are managed directly from Telegram via /source and /delivery

# 1. Telegram Bot Token from @BotFather
BOT_TOKEN=your_bot_token_here

# 2. Admin Telegram User IDs (Comma-separated integer user IDs)
ADMIN_IDS=your_admin_id_here

# 3. Database Connection String (SQLite for local testing, PostgreSQL for Railway production)
DATABASE_URL=sqlite+aiosqlite:///bot_database.db

# Optional Advanced Settings
MEDIA_GROUP_TIMEOUT=2.0
USER_SESSION_TIMEOUT=300.0
DELETE_AFTER_DELIVERY=false
MAX_RETRY=3
RETRY_DELAY=2.0
CLEANUP_DAYS=30
