# ==========================================
# AG DONE V3 - ENVIRONMENT CONFIGURATION
# ==========================================

# ------------------------------------------
# 1. Core Required Variables
# ------------------------------------------

# Telegram Bot Token from @BotFather (Required)
BOT_TOKEN=

# Admin Telegram User IDs (Comma-separated integer user IDs, e.g., 123456789,987654321) (Required)
ADMIN_IDS=

# Database Connection String
# SQLite default: sqlite+aiosqlite:///bot_database.db
# Railway PostgreSQL: postgresql+asyncpg://user:pass@host:port/dbname (Required in production)
DATABASE_URL=sqlite+aiosqlite:///bot_database.db

# ------------------------------------------
# 2. Payment Review Group Configuration
# ------------------------------------------
# Fixed Payment Review Group Chat ID (Default: -1004441603990)
PAYMENT_REVIEW_GROUP_ID=-1004441603990

# ------------------------------------------
# 3. Optional Payment Verification API Keys
# ------------------------------------------
BINANCE_API_KEY=
BINANCE_API_SECRET=
BYBIT_API_KEY=
BYBIT_API_SECRET=

# ------------------------------------------
# 4. Optional Dashboard & WebApp Configuration
# ------------------------------------------
# Application Port (Automatically provided by Railway)
PORT=8080

# Base URL of external WebApp Dashboard (e.g., https://your-app.up.railway.app)
DASHBOARD_URL=

# Admin Password for Web Dashboard login
DASHBOARD_ADMIN_PASSWORD=admin123

# Secret key used for session cookie signing
SESSION_SECRET=super_secret_dashboard_key_12345

# ------------------------------------------
# 5. Advanced Workflow Settings
# ------------------------------------------
MEDIA_GROUP_TIMEOUT=2.0
USER_SESSION_TIMEOUT=300.0
DELETE_AFTER_DELIVERY=false
MAX_RETRY=3
RETRY_DELAY=2.0
CLEANUP_DAYS=30
